    {
      "atomType": "Code",
      "x": 0.40939153439153436,
      "y": 0.44846796657381616,
      "uniqueID": "id-22910",
      "ioValues": [
        {
          "name": "toChamfer",
          "ioValue": "__GEOMETRY_INPUT__"
        },
        {
          "name": "distance",
          "ioValue": 1
        }
      ],
      "interpreterVersion": 1,
      "code": "function run(toChamfer: Assembly, distance: number) {\n  return toChamfer.onLeafs((leaf) => {\n    if (leaf.geometry instanceof replicad.Drawing || !replicad.isShape3D(leaf.geometry)) {\n      return leaf;\n    }\n    if (leaf.selection?.part) {\n      leaf.geometry = leaf.geometry.chamfer(distance)\n      return leaf;\n    }\n    // else apply only to filtered faces and edges\n    let edgesToChamfer: replicad.Edge[] = []\n    if (leaf.selection?.faces) {\n      leaf.selection.faces.forEach((faceIndex) => {\n        edgesToChamfer.push(...leaf.geometry.faces[faceIndex].edges)\n      });\n    }\n    if (leaf.selection?.edges) {\n      edgesToChamfer.push(...leaf.selection.edges.map((index) => leaf.geometry.edges[index]))\n    }\n    if (edgesToChamfer.length == 0) {\n      return leaf;\n    }\n    edgesToChamfer = edgesToChamfer.filter((e) => e != null)\n    if (edgesToChamfer.length == 0) {\n      return leaf;\n    }\n    leaf.geometry = leaf.geometry.chamfer(distance, (e) => { return e.inList(edgesToChamfer.map((e) => e.clone())) })\n    return leaf;\n  })\n}",
      "compiledCode": "\"use strict\";\nfunction run(toChamfer, distance) {\n    return toChamfer.onLeafs((leaf) => {\n        if (leaf.geometry instanceof replicad.Drawing || !replicad.isShape3D(leaf.geometry)) {\n            return leaf;\n        }\n        if (leaf.selection?.part) {\n            leaf.geometry = leaf.geometry.chamfer(distance);\n            return leaf;\n        }\n        // else apply only to filtered faces and edges\n        let edgesToChamfer = [];\n        if (leaf.selection?.faces) {\n            leaf.selection.faces.forEach((faceIndex) => {\n                edgesToChamfer.push(...leaf.geometry.faces[faceIndex].edges);\n            });\n        }\n        if (leaf.selection?.edges) {\n            edgesToChamfer.push(...leaf.selection.edges.map((index) => leaf.geometry.edges[index]));\n        }\n        if (edgesToChamfer.length == 0) {\n            return leaf;\n        }\n        edgesToChamfer = edgesToChamfer.filter((e) => e != null);\n        if (edgesToChamfer.length == 0) {\n            return leaf;\n        }\n        leaf.geometry = leaf.geometry.chamfer(distance, (e) => { return e.inList(edgesToChamfer.map((e) => e.clone())); });\n        return leaf;\n    });\n}\n"
    },
